generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  createdAt             DateTime              @default(now())
  documento             String?               @unique
  id                    String                @id @default(uuid())
  nome                  String
  updatedAt             DateTime              @updatedAt
  adendos               Adendo[]
  categoriasFinanceiras CategoriaFinanceira[]
  clientes              Cliente[]
  contasBancarias       ContaBancaria[]
  contatos              Contato[]
  contratos             Contrato[]
  funcionarios          Funcionario[]
  obras                 Obra[]
  registrosPresenca     RegistroPresenca[]
  transacoes            TransacaoFinanceira[]
  usuarios              Usuario[]

  @@map("tenants")
}

model Usuario {
  createdAt   DateTime @default(now())
  email       String
  firebaseUid String   @unique
  id          String   @id @default(uuid())
  nome        String
  role        String   @default("USER")
  tenantId    String
  updatedAt   DateTime @updatedAt
  status      String   @default("PENDENTE")
  telefone    String?  @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("usuarios")
}

model Cliente {
  cpfCnpj   String?
  createdAt DateTime @default(now())
  email     String?
  id        String   @id @default(uuid())
  nome      String
  telefone  String?
  tenantId  String
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, cpfCnpj])
  @@index([tenantId])
  @@map("clientes")
}

model Funcionario {
  cargo                String
  createdAt            DateTime              @default(now())
  id                   String                @id @default(uuid())
  nome                 String
  salario              Decimal?
  tenantId             String
  updatedAt            DateTime              @updatedAt
  valorDiariaMotorista Decimal?
  tipoPagamento        String                @default("MENSAL")
  valorDiaria          Decimal?
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrosPresenca    RegistroPresenca[]
  transacaoFinanceiras TransacaoFinanceira[]

  @@index([tenantId])
  @@map("funcionarios")
}

model Obra {
  createdAt             DateTime              @default(now())
  endereco              String?
  id                    String                @id @default(uuid())
  nome                  String
  status                String                @default("EM_ANDAMENTO")
  tenantId              String
  updatedAt             DateTime              @updatedAt
  progressoAlvenaria    Int                   @default(0)
  progressoEntrega      Int                   @default(0)
  progressoEscavacao    Int                   @default(0)
  progressoHidraulica   Int                   @default(0)
  progressoRevestimento Int                   @default(0)
  contrato              Contrato?
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrosPresenca     RegistroPresenca[]
  transacoes            TransacaoFinanceira[]

  @@index([tenantId])
  @@map("obras")
}

model RegistroPresenca {
  createdAt        DateTime    @default(now())
  data             DateTime
  funcionarioId    String
  id               String      @id @default(uuid())
  obraId           String
  observacao       String?
  status           String
  tenantId         String
  updatedAt        DateTime    @updatedAt
  horasTrabalhadas Decimal?    @default(8)
  percentualPago   Decimal?    @default(100)
  statusAprovacao  String      @default("PENDENTE")
  funcionario      Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  obra             Obra        @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([obraId])
  @@index([funcionarioId])
  @@map("registros_presenca")
}

model Contato {
  createdAt     DateTime @default(now())
  email         String?
  especialidade String?
  id            String   @id @default(uuid())
  nome          String
  telefone      String?
  tenantId      String
  updatedAt     DateTime @updatedAt
  documento     String?
  tipo          String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("contatos")
}

model Contrato {
  id         String    @id @default(uuid())
  descricao  String
  valor      Decimal
  dataInicio DateTime?
  dataFim    DateTime?
  status     String    @default("ATIVO")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  obraId     String    @unique
  tenantId   String
  adendos    Adendo[]
  obra       Obra      @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("contratos")
}

model Adendo {
  id                   String                @id @default(uuid())
  descricao            String
  valor                Decimal
  dataAssinatura       DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  contratoId           String
  tenantId             String
  contrato             Contrato              @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transacaoFinanceiras TransacaoFinanceira[]

  @@index([tenantId])
  @@index([contratoId])
  @@map("adendos")
}

model CategoriaFinanceira {
  id         String                @id @default(uuid())
  codigo     String
  descricao  String
  tipo       String
  isAtiva    Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  tenantId   String
  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transacoes TransacaoFinanceira[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@map("categorias_financeiras")
}

model ContaBancaria {
  id           String                @id @default(uuid())
  nome         String
  banco        String?
  agencia      String?
  conta        String?
  saldoInicial Decimal               @default(0)
  isAtiva      Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  tenantId     String
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transacoes   TransacaoFinanceira[]

  @@index([tenantId])
  @@map("contas_bancarias")
}

model TransacaoFinanceira {
  createdAt         DateTime             @default(now())
  dataPagamento     DateTime?
  dataVencimento    DateTime?
  descricao         String
  id                String               @id @default(uuid())
  obraId            String
  status            String               @default("PENDENTE")
  tenantId          String
  tipo              String
  updatedAt         DateTime             @updatedAt
  valor             Decimal
  categoria         String?
  categoriaId       String?
  adendoId          String?
  clienteFornecedor String?
  funcionarioId     String?
  codigoBarras      String?
  observacao        String?
  contaBancariaId   String?
  comprovanteUrl    String?
  adendo            Adendo?              @relation(fields: [adendoId], references: [id])
  categoriaFk       CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])
  contaBancaria     ContaBancaria?       @relation(fields: [contaBancariaId], references: [id])
  funcionario       Funcionario?         @relation(fields: [funcionarioId], references: [id])
  obra              Obra                 @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([obraId])
  @@index([categoriaId])
  @@index([contaBancariaId])
  @@map("transacoes_financeiras")
}
