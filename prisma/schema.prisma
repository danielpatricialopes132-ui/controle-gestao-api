generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  createdAt             DateTime              @default(now())
  documento             String?               @unique
  id                    String                @id @default(uuid())
  nome                  String
  logoUrl               String?
  corPrimaria           String?
  updatedAt             DateTime              @updatedAt
  adendos               Adendo[]
  categoriasFinanceiras CategoriaFinanceira[]
  clientes              Cliente[]
  contasBancarias       ContaBancaria[]
  contatos              Contato[]
  contratos             Contrato[]
  funcionarios          Funcionario[]
  obras                 Obra[]
  registrosPresenca     RegistroPresenca[]
  transacoes            TransacaoFinanceira[]
  usuarios              Usuario[]
  fornecedores          Fornecedor[]
  produtos              Produto[]
  estoques              Estoque[]
  estoqueItens          EstoqueItem[]
  ordensCompra          OrdemCompra[]
  ordemCompraItens      OrdemCompraItem[]
  propostas             Proposta[]
  equipamentos          Equipamento[]
  alocacoesEquipamento  AlocacaoEquipamento[]
  manutencoesPreventivas ManutencaoPreventiva[]
  documentosObras       DocumentoObra[]
  fotosObras            FotoObra[]
  etapasCronograma      EtapaCronograma[]
  logsAuditoria         LogAuditoria[]
  notasFiscais          NotaFiscal[]
  contratosEmpreiteiro  ContratoEmpreiteiro[]
  adendosEmpreiteiro    AdendoContratoEmpreiteiro[]
  medicoesEmpreiteiro   MedicaoEmpreiteiro[]
  revistasObra          RevistaObra[]
  terceirosCliente      TerceiroCliente[]
  punchListItens        PunchListItem[]
  visitasTerceiroCliente VisitaTerceiroCliente[]
  autorizacoesPortaria   AutorizacaoAcessoPortaria[]
  termosRecebimento      TermoRecebimentoInteriores[]
  termosRetirada         TermoRetiradaItem[]

  @@map("tenants")
}

model Usuario {
  createdAt   DateTime @default(now())
  email       String
  firebaseUid String   @unique
  id          String   @id @default(uuid())
  nome        String
  role        String   @default("USER")
  tenantId    String
  updatedAt   DateTime @updatedAt
  status      String   @default("PENDENTE")
  telefone    String?  @unique
  fcmTokens   String[] @default([])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logsAuditoria LogAuditoria[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("usuarios")
}

model Cliente {
  cpfCnpj   String?
  createdAt DateTime @default(now())
  email     String?
  id        String   @id @default(uuid())
  nome      String
  telefone  String?
  tenantId  String
  tokenPortal String? @unique
  updatedAt DateTime @updatedAt
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propostas Proposta[]
  notasFiscais NotaFiscal[]

  @@unique([tenantId, cpfCnpj])
  @@index([tenantId])
  @@map("clientes")
}

model Funcionario {
  cargo                String
  createdAt            DateTime              @default(now())
  id                   String                @id @default(uuid())
  nome                 String
  salario              Decimal?
  tenantId             String
  updatedAt            DateTime              @updatedAt
  valorDiariaMotorista Decimal?
  tipoPagamento        String                @default("MENSAL")
  valorDiaria          Decimal?
  tipoColaborador      String                @default("CLT") // CLT, DIARISTA, EMPREITEIRO
  cpfCnpj              String?
  chavePix             String?
  fornecedorId         String?
  fornecedor           Fornecedor?           @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrosPresenca    RegistroPresenca[]
  transacaoFinanceiras TransacaoFinanceira[]

  @@index([tenantId])
  @@index([fornecedorId])
  @@map("funcionarios")
}

model Obra {
  createdAt             DateTime              @default(now())
  endereco              String?
  id                    String                @id @default(uuid())
  nome                  String
  status                String                @default("EM_ANDAMENTO")
  tenantId              String
  updatedAt             DateTime              @updatedAt
  progressoAlvenaria    Int                   @default(0)
  progressoEntrega      Int                   @default(0)
  progressoEscavacao    Int                   @default(0)
  progressoHidraulica   Int                   @default(0)
  progressoRevestimento Int                   @default(0)
  contrato              Contrato?
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrosPresenca     RegistroPresenca[]
  transacoes            TransacaoFinanceira[]
  estoque               Estoque?
  ordensCompra          OrdemCompra[]
  propostaId            String?               @unique
  proposta              Proposta?             @relation(fields: [propostaId], references: [id], onDelete: SetNull)
  alocacoesEquipamento  AlocacaoEquipamento[]
  documentos            DocumentoObra[]
  fotos                 FotoObra[]
  etapasCronograma      EtapaCronograma[]
  notasFiscais          NotaFiscal[]
  contratosEmpreiteiro  ContratoEmpreiteiro[]
  revistas              RevistaObra[]
  terceiros             TerceiroCliente[]
  punchList             PunchListItem[]
  visitasTerceiros      VisitaTerceiroCliente[]
  autorizacoesPortaria  AutorizacaoAcessoPortaria[]
  termosRecebimento     TermoRecebimentoInteriores[]
  termosRetirada        TermoRetiradaItem[]

  @@index([tenantId])
  @@map("obras")
}

model RegistroPresenca {
  createdAt        DateTime    @default(now())
  data             DateTime
  funcionarioId    String
  id               String      @id @default(uuid())
  obraId           String
  observacao       String?
  status           String
  tenantId         String
  updatedAt        DateTime    @updatedAt
  horasTrabalhadas Decimal?    @default(8)
  percentualPago   Decimal?    @default(100)
  statusAprovacao  String      @default("PENDENTE")
  funcionario      Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  obra             Obra        @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([obraId])
  @@index([funcionarioId])
  @@map("registros_presenca")
}

model Contato {
  createdAt     DateTime @default(now())
  email         String?
  especialidade String?
  id            String   @id @default(uuid())
  nome          String
  telefone      String?
  tenantId      String
  updatedAt     DateTime @updatedAt
  documento     String?
  tipo          String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("contatos")
}

model Contrato {
  id         String    @id @default(uuid())
  descricao  String
  valor      Decimal
  dataInicio DateTime?
  dataFim    DateTime?
  status     String    @default("ATIVO")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  obraId     String    @unique
  tenantId   String
  adendos    Adendo[]
  obra       Obra      @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("contratos")
}

model Adendo {
  id                   String                @id @default(uuid())
  descricao            String
  valor                Decimal
  dataAssinatura       DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  contratoId           String
  tenantId             String
  contrato             Contrato              @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transacaoFinanceiras TransacaoFinanceira[]

  @@index([tenantId])
  @@index([contratoId])
  @@map("adendos")
}

model CategoriaFinanceira {
  id         String                @id @default(uuid())
  codigo     String
  descricao  String
  tipo       String
  isAtiva    Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  tenantId   String
  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transacoes TransacaoFinanceira[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@map("categorias_financeiras")
}

model ContaBancaria {
  id           String                @id @default(uuid())
  nome         String
  banco        String?
  agencia      String?
  conta        String?
  saldoInicial Decimal               @default(0)
  isAtiva      Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  tenantId     String
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transacoes   TransacaoFinanceira[]

  @@index([tenantId])
  @@map("contas_bancarias")
}

model TransacaoFinanceira {
  createdAt         DateTime             @default(now())
  dataPagamento     DateTime?
  dataVencimento    DateTime?
  descricao         String
  id                String               @id @default(uuid())
  obraId            String?
  status            String               @default("PENDENTE")
  tenantId          String
  tipo              String
  updatedAt         DateTime             @updatedAt
  valor             Decimal
  categoria         String?
  categoriaId       String?
  adendoId          String?
  clienteFornecedor String?
  funcionarioId     String?
  codigoBarras      String?
  observacao        String?
  contaBancariaId   String?
  comprovanteUrl    String?
  
  // Controle de Conciliação e RH
  isConciliada      Boolean              @default(false)
  ofxId             String?
  isAdiantamento    Boolean              @default(false)

  adendo            Adendo?              @relation(fields: [adendoId], references: [id])
  categoriaFk       CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])
  contaBancaria     ContaBancaria?       @relation(fields: [contaBancariaId], references: [id])
  funcionario       Funcionario?         @relation(fields: [funcionarioId], references: [id])
  obra              Obra?                @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ordemCompra       OrdemCompra?
  medicaoEmpreiteiroId String?             @unique
  medicaoEmpreiteiro   MedicaoEmpreiteiro? @relation(fields: [medicaoEmpreiteiroId], references: [id])

  @@index([tenantId])
  @@index([obraId])
  @@index([categoriaId])
  @@index([contaBancariaId])
  @@map("transacoes_financeiras")
}

model Fornecedor {
  id                     String                @id @default(uuid())
  nome                   String
  cnpj                   String?
  telefone               String?
  email                  String?
  tipoFornecedor         String                @default("MATERIAL") // MATERIAL, EMPREITEIRO, SUBCONTRATADO, SERVICO
  empreiteiroPaiId       String?
  chavePix               String?
  banco                  String?
  agencia                String?
  conta                  String?
  cndInssValidade        DateTime?
  cndTrabalhistaValidade DateTime?
  tenantId               String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  empreiteiroPai         Fornecedor?           @relation("Subcontratados", fields: [empreiteiroPaiId], references: [id], onDelete: SetNull)
  subcontratados         Fornecedor[]          @relation("Subcontratados")
  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ordens                 OrdemCompra[]
  contratosEmpreiteiro   ContratoEmpreiteiro[]
  funcionarios           Funcionario[]

  @@index([tenantId])
  @@index([empreiteiroPaiId])
  @@map("fornecedores")
}

model Produto {
  id            String   @id @default(uuid())
  nome          String
  unidadeMedida String   
  precoBase     Decimal? @default(0)
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estoqueItens  EstoqueItem[]
  ordemItens    OrdemCompraItem[]

  @@index([tenantId])
  @@map("produtos")
}

model Estoque {
  id        String   @id @default(uuid())
  nome      String
  obraId    String?  @unique
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  obra      Obra?    @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itens     EstoqueItem[]

  @@index([tenantId])
  @@map("estoques")
}

model EstoqueItem {
  id        String   @id @default(uuid())
  estoqueId String
  produtoId String
  quantidade Decimal @default(0)
  tenantId  String
  estoque   Estoque  @relation(fields: [estoqueId], references: [id], onDelete: Cascade)
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([estoqueId, produtoId])
  @@index([tenantId])
  @@map("estoque_itens")
}

model OrdemCompra {
  id            String   @id @default(uuid())
  numero        Int      @default(autoincrement())
  fornecedorId  String
  obraId        String?
  status        String   @default("PENDENTE")
  valorTotal    Decimal  @default(0)
  dataPrevisao  DateTime?
  dataEntrega   DateTime?
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transacaoId   String?  @unique

  fornecedor    Fornecedor @relation(fields: [fornecedorId], references: [id])
  obra          Obra?      @relation(fields: [obraId], references: [id])
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transacao     TransacaoFinanceira? @relation(fields: [transacaoId], references: [id])
  itens         OrdemCompraItem[]

  @@index([tenantId])
  @@index([obraId])
  @@map("ordens_compra")
}

model OrdemCompraItem {
  id            String   @id @default(uuid())
  ordemCompraId String
  produtoId     String
  quantidade    Decimal
  precoUnitario Decimal
  tenantId      String

  ordemCompra   OrdemCompra @relation(fields: [ordemCompraId], references: [id], onDelete: Cascade)
  produto       Produto     @relation(fields: [produtoId], references: [id])
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([ordemCompraId])
  @@map("ordens_compra_itens")
}

model Proposta {
  id           String         @id @default(uuid())
  titulo       String
  valorTotal   Decimal        @default(0)
  validadeDias Int            @default(15)
  status       String         @default("RASCUNHO") // RASCUNHO, ENVIADA, APROVADA, REJEITADA
  termos       String?
  nfUrl        String?        // URL/caminho da nota fiscal anexada pelo usuário
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  clienteId    String
  tenantId     String

  cliente      Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itens        PropostaItem[]
  obra         Obra?

  @@index([tenantId])
  @@index([clienteId])
  @@map("propostas")
}

model PropostaItem {
  id            String   @id @default(uuid())
  descricao     String
  quantidade    Decimal  @default(1)
  valorUnitario Decimal  @default(0)
  valorTotal    Decimal  @default(0)

  propostaId    String
  proposta      Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  @@index([propostaId])
  @@map("proposta_itens")
}

model Equipamento {
  id             String   @id @default(uuid())
  identificador  String   // Placa ou ID interno
  marca          String?
  modelo         String?
  ano            Int?
  custoDiario    Decimal  @default(0)
  status         String   @default("DISPONIVEL") // DISPONIVEL, ALOCADO, MANUTENCAO
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alocacoes      AlocacaoEquipamento[]
  manutencoes    ManutencaoPreventiva[]

  @@index([tenantId])
  @@map("equipamentos")
}

model AlocacaoEquipamento {
  id                String   @id @default(uuid())
  equipamentoId     String
  obraId            String
  dataInicio        DateTime
  dataFim           DateTime?
  custoTotalGerado  Decimal  @default(0)
  tenantId          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  equipamento       Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  obra              Obra        @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([equipamentoId])
  @@index([obraId])
  @@index([tenantId])
  @@map("alocacoes_equipamento")
}

model ManutencaoPreventiva {
  id                String   @id @default(uuid())
  equipamentoId     String
  dataProgramada    DateTime
  descricao         String
  custoEstimado     Decimal  @default(0)
  status            String   @default("PENDENTE") // PENDENTE, CONCLUIDA, ATRASADA
  tenantId          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  equipamento       Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([equipamentoId])
  @@index([tenantId])
  @@map("manutencoes_preventivas")
}

model DocumentoObra {
  id          String   @id @default(uuid())
  nome        String
  tipo        String   // PLANTA, ART, CONTRATO, RECIBO, OUTROS
  url         String
  tamanhoBytes Int?
  obraId      String
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  obra        Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@index([tenantId])
  @@map("documentos_obra")
}

model FotoObra {
  id          String   @id @default(uuid())
  url         String
  descricao   String?
  obraId      String
  tenantId    String
  createdAt   DateTime @default(now())

  obra        Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@index([tenantId])
  @@map("fotos_obra")
}

model EtapaCronograma {
  id                  String   @id @default(uuid())
  nome                String
  dataInicioEstimada  DateTime
  dataFimEstimada     DateTime
  dataFimReal         DateTime?
  percentualConclusao Decimal  @default(0)
  custoPrevisto       Decimal  @default(0)
  obraId              String
  tenantId            String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  obra                Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@index([tenantId])
  @@map("etapas_cronograma")
}

model LogAuditoria {
  id        String   @id @default(uuid())
  usuarioId String
  acao      String
  modulo    String
  detalhes  String?  // JSON stringificado
  createdAt DateTime @default(now())
  tenantId  String

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([tenantId])
  @@map("logs_auditoria")
}

model NotaFiscal {
  id        String   @id @default(uuid())
  numero    String?
  obraId    String
  clienteId String
  valor     Decimal  @default(0)
  status    String   @default("PROCESSANDO") // PROCESSANDO, AUTORIZADA, REJEITADA
  xmlUrl    String?
  pdfUrl    String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  obra      Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@index([clienteId])
  @@index([tenantId])
  @@map("notas_fiscais")
}

model ContratoEmpreiteiro {
  id                   String                      @id @default(uuid())
  numero               String?
  descricao            String
  valorOriginal        Decimal                     @default(0)
  dataInicio           DateTime?
  dataFim              DateTime?
  status               String                      @default("ATIVO") // ATIVO, CONCLUIDO, RESCINDIDO, SUSPENSO
  aliquotaInss         Decimal                     @default(11.0)
  aliquotaIss          Decimal                     @default(5.0)
  aliquotaIrrf         Decimal                     @default(0.0)
  documentoContratoUrl String?
  observacoes          String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  obraId               String
  fornecedorId         String
  tenantId             String

  obra                 Obra                        @relation(fields: [obraId], references: [id], onDelete: Cascade)
  fornecedor           Fornecedor                  @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  tenant               Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adendos              AdendoContratoEmpreiteiro[]
  medicoes             MedicaoEmpreiteiro[]

  @@index([tenantId])
  @@index([obraId])
  @@index([fornecedorId])
  @@map("contratos_empreiteiro")
}

model AdendoContratoEmpreiteiro {
  id                    String              @id @default(uuid())
  contratoEmpreiteiroId String
  numero                Int                 @default(1)
  descricao             String
  tipo                  String              @default("VALOR_E_PRAZO") // VALOR, PRAZO, ESCOPO, VALOR_E_PRAZO
  valorAdicional        Decimal             @default(0)
  novaDataFim           DateTime?
  dataAssinatura        DateTime?
  documentoUrl          String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  tenantId              String

  contratoEmpreiteiro   ContratoEmpreiteiro @relation(fields: [contratoEmpreiteiroId], references: [id], onDelete: Cascade)
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([contratoEmpreiteiroId])
  @@index([tenantId])
  @@map("adendos_contrato_empreiteiro")
}

model MedicaoEmpreiteiro {
  id                            String              @id @default(uuid())
  numero                        Int                 @default(1)
  contratoEmpreiteiroId         String
  dataMedicao                   DateTime            @default(now())
  periodoInicio                 DateTime?
  periodoFim                    DateTime?
  descricao                     String
  valorBruto                    Decimal             @default(0)
  valorInssRetido               Decimal             @default(0)
  valorIssRetido                Decimal             @default(0)
  valorIrrfRetido               Decimal             @default(0)
  valorDeducaoSubcontratados    Decimal             @default(0)
  valorAdiantamentosDescontados Decimal             @default(0)
  valorLiquidoAPagar            Decimal             @default(0)
  status                        String              @default("PENDENTE") // PENDENTE, APROVADA, PAGA, GLOSADA
  relatorioFotograficoUrl       String?
  notaFiscalUrl                 String?
  observacoes                   String?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  tenantId                      String

  contratoEmpreiteiro           ContratoEmpreiteiro @relation(fields: [contratoEmpreiteiroId], references: [id], onDelete: Cascade)
  tenant                        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transacao                     TransacaoFinanceira?

  @@index([contratoEmpreiteiroId])
  @@index([tenantId])
  @@map("medicoes_empreiteiro")
}

model RevistaObra {
  id                 String   @id @default(uuid())
  tenantId           String
  obraId             String
  tipoPeriodicidade  String   @default("MENSAL") // "SEMANAL" ou "MENSAL"
  titulo             String
  periodoReferencia  String   // Ex: "2026-09" ou "Semana 38/2026"
  dataInicio         DateTime
  dataFim            DateTime
  capaUrl            String?
  editorial          String?  @db.Text
  destaques          String?  @db.Text
  lookahead          String?  @db.Text
  climaDiasSol       Int      @default(0)
  climaDiasChuva     Int      @default(0)
  percentualAvanco   Decimal  @default(0)
  fotosSelecionadas  Json?    // Array [{ url, legenda, ambiente, tag, antesDepois }]
  mapaVisitas        Json?    // Mapa semanal S-T-Q-Q-S-S-D consolidado dos terceiros
  pdfUrl             String?
  status             String   @default("RASCUNHO") // RASCUNHO, PUBLICADA
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  obra               Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@index([tenantId])
  @@map("revistas_obra")
}

model TerceiroCliente {
  id                 String          @id @default(uuid())
  tenantId           String
  obraId             String
  nomeEmpresa        String
  especialidade      String          // MARCENARIA, MARMORARIA, AUTOMACAO, CLIMATIZACAO, ESQUADRIAS, DECORACAO, OUTROS
  responsavel        String?
  telefone           String?
  email              String?
  valorContrato      Decimal?        @default(0)
  status             String          @default("CONTRATADO") // CONTRATADO, MEDICAO_IN_LOCO, FABRICACAO, PRONTO_ENTREGA, MONTAGEM, ENTREGUE_APROVADO
  dataPrevisaoInicio DateTime?
  dataPrevisaoFim    DateTime?
  observacoes        String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  obra               Obra            @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  punchList          PunchListItem[]
  visitas            VisitaTerceiroCliente[]
  autorizacoesPortaria AutorizacaoAcessoPortaria[]
  termosRetirada     TermoRetiradaItem[]

  @@index([obraId])
  @@index([tenantId])
  @@map("terceiros_cliente")
}

model PunchListItem {
  id                String           @id @default(uuid())
  tenantId          String
  obraId            String
  terceiroClienteId String?
  ambiente          String
  descricao         String           @db.Text
  fotoUrl           String?
  status            String           @default("PENDENTE") // PENDENTE, EM_CORRECAO, RESOLVIDO
  prazoCorrecao     DateTime?
  dataResolucao     DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  obra              Obra             @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terceiro          TerceiroCliente? @relation(fields: [terceiroClienteId], references: [id], onDelete: SetNull)

  @@index([obraId])
  @@index([tenantId])
  @@index([terceiroClienteId])
  @@map("punch_list_itens")
}

model VisitaTerceiroCliente {
  id                String          @id @default(uuid())
  tenantId          String
  obraId            String
  terceiroClienteId String
  dataVisita        DateTime
  motivo            String?         // MEDICAO, MONTAGEM, VISTORIA, ALINHAMENTO, OUTROS
  observacoes       String?         @db.Text
  responsavel       String?         // Nome do técnico/responsável presente
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  terceiro          TerceiroCliente @relation(fields: [terceiroClienteId], references: [id], onDelete: Cascade)
  obra              Obra            @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([terceiroClienteId])
  @@index([obraId])
  @@index([tenantId])
  @@index([dataVisita])
  @@map("visitas_terceiro_cliente")
}

model AutorizacaoAcessoPortaria {
  id                String           @id @default(uuid())
  tenantId          String
  obraId            String
  terceiroClienteId String?
  tipoAcesso        String           @default("TERCEIRO_CLIENTE") // TERCEIRO_CLIENTE, EMPREITEIRO, PRESTADOR_SERVICO
  empresaNome       String
  veiculoPlaca      String?
  veiculoModelo     String?
  dataInicio        DateTime
  dataFim           DateTime
  horarioPermitido  String?          // Ex: "08:00 às 17:00"
  colaboradores     Json             // Array: [{ nome, rg, cpf, funcao }]
  regrasCondominio  String?          @db.Text
  status            String           @default("AUTORIZADO") // AUTORIZADO, EXPIRADO, CANCELADO
  observacoes       String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  obra              Obra             @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terceiro          TerceiroCliente? @relation(fields: [terceiroClienteId], references: [id], onDelete: SetNull)

  @@index([obraId])
  @@index([tenantId])
  @@index([terceiroClienteId])
  @@map("autorizacoes_acesso_portaria")
}

model TermoRecebimentoInteriores {
  id                       String    @id @default(uuid())
  tenantId                 String
  obraId                   String
  numeroTermo              String    // Ex: "REC-2026-001"
  dataEmissao              DateTime  @default(now())
  statusPunchList          String    @default("TODOS_RESOLVIDOS") // TODOS_RESOLVIDOS, COM_RESSALVAS_MENORES
  totalItensVistoriados    Int       @default(0)
  totalItensResolvidos     Int       @default(0)
  detalhesAmbientes        Json?     // Snapshot dos ambientes e inspeções
  ressalvasObservacoes     String?   @db.Text
  nomeCliente              String
  documentoCliente         String?   // CPF / RG
  assinaturaDigitalCliente String?   @db.Text // Base64 PNG do traço
  dataAssinatura           DateTime?
  responsavelTecnico       String?
  status                   String    @default("ASSINADO") // RASCUNHO, ASSINADO
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  obra                     Obra      @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@index([tenantId])
  @@map("termos_recebimento_interiores")
}

model TermoRetiradaItem {
  id                               String           @id @default(uuid())
  tenantId                         String
  obraId                           String
  terceiroClienteId                String?
  numeroTermo                      String           // Ex: "RET-2026-001"
  dataRetirada                     DateTime         @default(now())
  previsaoDevolucao                DateTime?
  dataDevolucaoReal                DateTime?
  empresaRetirante                 String
  nomeResponsavelRetirada          String
  documentoResponsavel             String?          // RG / CPF
  itensRetirados                   Json             // Array [{ item, quantidade, unidade, estadoConservacao, observacao }]
  motivoRetirada                   String           // USINAGEM_BANCADA, CORTE_AJUSTE, PINTURA_OFICINA, TESTE, OUTROS
  assinaturaDigitalRetirante       String?          @db.Text // Base64 PNG
  assinaturaDigitalResponsavelObra String?          @db.Text // Base64 PNG
  status                           String           @default("RETIRADO") // RETIRADO, DEVOLVIDO_PARCIAL, DEVOLVIDO_TOTAL, CANCELADO
  observacoes                      String?          @db.Text
  createdAt                        DateTime         @default(now())
  updatedAt                        DateTime         @updatedAt

  obra                             Obra             @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tenant                           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terceiro                         TerceiroCliente? @relation(fields: [terceiroClienteId], references: [id], onDelete: SetNull)

  @@index([obraId])
  @@index([tenantId])
  @@index([terceiroClienteId])
  @@map("termos_retirada_itens")
}



